[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Target = linux-aarch64
Target = linux-aarch64-16k
Target = linux-aarch64-64k

[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/initcpio/*
Target = usr/lib/firmware/*
Target = usr/lib/modules/*/extramodules/
Target = usr/src/*/dkms.conf
Target = usr/lib/systemd/systemd
Target = usr/bin/cryptsetup
Target = usr/bin/lvm

[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Target = mkinitcpio
Target = mkinitcpio-git

[Action]
Description = Rebuilding the AArch64 Omarchy boot entry...
When = PostTransaction
Exec = /usr/bin/omarchy-update-kernel-aarch64
