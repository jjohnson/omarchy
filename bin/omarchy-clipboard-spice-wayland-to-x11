#!/bin/bash

# omarchy:summary=Mirror the Wayland clipboard to SPICE's X11 clipboard
# omarchy:group=clipboard
# omarchy:hidden=true

# spice-vdagent 0.23 owns an X11 clipboard even when Omarchy runs a Wayland
# session. Hyprland does not reliably mirror native Wayland selections into
# that clipboard, so feed text changes to X11 explicitly.
exec wl-paste -n --watch xclip -selection clipboard -r -i
